#!/usr/bin/env bash
# GitHub Issue をターミナルから素早く登録する
# 使い方:
#   task                      # タイトルだけ入力（ラベル自動判定）
#   task "タイトル"            # 引数モード
#   task "タイトル" today      # today フラグ付き
#   task "タイトル" today p0   # 優先度も指定
set -euo pipefail

REPO="kazu098/personal-ops"
GREEN="\033[32m"; CYAN="\033[36m"; DIM="\033[2m"; RESET="\033[0m"

# ── ラベル自動判定 ────────────────────────────────────────────
detect_area() {
  local t="${1,,}"  # lowercase
  [[ "$t" =~ ミーア|mia ]]                           && echo "area:mia"       && return
  [[ "$t" =~ cooking|料理|レシピ|食 ]]               && echo "area:ai-cooking" && return
  [[ "$t" =~ ブログ|blog|note|記事|linkedin ]]        && echo "area:blog"      && return
  [[ "$t" =~ 英語|韓国語|topik|勉強|学習|reading ]]  && echo "area:study"     && return
  [[ "$t" =~ 調査|research|リサーチ|競合 ]]           && echo "area:research"  && return
  echo "area:admin"
}

detect_type() {
  local t="${1,,}"
  [[ "$t" =~ 実装|開発|修正|バグ|コード|機能|音声|音量|ui|api|設計 ]] && echo "type:dev"      && return
  [[ "$t" =~ 記事|執筆|ブログ|writing|draft ]]                         && echo "type:writing"  && return
  [[ "$t" =~ 調査|research|リサーチ|競合|分析 ]]                        && echo "type:research" && return
  [[ "$t" =~ 英語|韓国語|topik|勉強|学習 ]]                             && echo "type:learning" && return
  echo "type:ops"
}

detect_priority() {
  local t="${1,,}"
  [[ "$t" =~ 最優先|緊急|urgent|p0|優先度高|優先高 ]] && echo "priority:p0" && return
  [[ "$t" =~ 低優先|優先度低|優先低|p2|low ]]         && echo "priority:p2" && return
  echo "priority:p1"
}

# ── メイン ────────────────────────────────────────────────────
TITLE="${1:-}"
if [[ -z "$TITLE" ]]; then
  read -rp $'\033[36mタイトル: \033[0m' TITLE
fi
[[ -z "$TITLE" ]] && echo "タイトルは必須です" && exit 1

AREA=$(detect_area "$TITLE")
TYPE=$(detect_type "$TITLE")
PRIORITY=$(detect_priority "$TITLE")
LABELS="${AREA},${TYPE},${PRIORITY}"

# 追加フラグ（today / this-week / p0 / p2）
shift 1 2>/dev/null || true
for arg in "$@"; do
  case "$arg" in
    today|this-week|waiting) LABELS="${LABELS},${arg}" ;;
    p0|p1|p2) PRIORITY="priority:${arg}"; LABELS=$(echo "$LABELS" | sed "s/priority:[^,]*/priority:${arg}/") ;;
  esac
done

echo -e "${DIM}  labels: ${LABELS}${RESET}"
URL=$(gh issue create --repo "$REPO" --title "$TITLE" --label "$LABELS" 2>&1)
echo -e "${GREEN}✅ ${URL}${RESET}"
